<Project>

  <!--
    Production-only build.
    This file is imported before the SDK props, so it wins over the SDK's Debug default.
    Release is the only configuration, and the ProductionOnly target rejects anything else.
  -->
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <Configurations>Release</Configurations>
  </PropertyGroup>

</Project>
